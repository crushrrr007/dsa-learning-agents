  "reference_solution": "def two_sum(nums, target):\n    seen = {}\n    for i, x in enumerate(nums):\n        need = target - x\n        if need in seen:\n            return sorted([seen[need], i])\n        seen[x] = i\n    return [-1, -1]\n",
