    },
    {
      "input": "nums=[3,3], target=6",
      "output": "[0, 1]"
    }
  ],
  "constraints": [
    "2 <= len(nums) <= 200",
    "Exactly one valid pair exists"
  ],
  "starter_code": "def two_sum(nums, target):\n    # Keep scanning nums; build a value->index map as you go\n    return [0, 1]\n",
  "function_name": "two_sum",
  "visual": "array",
  "brute_force_code": "def two_sum(nums, target):\n    n = len(nums)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if nums[i] + nums[j] == target:\n                return [i, j]\n    return [-1, -1]\n",
